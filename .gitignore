```gitignore
# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/
# Flask instance data
# Contains the local SQLite database and runtime files
instance/

# SQLite databases and runtime files
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
*.sqlite3
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal

# Environment variables / secrets
.env
.env.*
!.env.example
*.key
*.pem

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Type checking / linting caches
.mypy_cache/
.ruff_cache/

# Build / packaging
build/
dist/
*.egg-info/
.eggs/

# IDE / editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS junk
.DS_Store
Thumbs.db

# Logs
*.log
logs/
```
app/static/audio/tavern.mp3
